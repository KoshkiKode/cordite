// ═══════════════════════════════════════════════════════════════════════════════
// Cliff Face Shader — Cordite Wars: Six Fronts
// ═══════════════════════════════════════════════════════════════════════════════
//
// Dedicated shader for cliff face meshes generated by CliffGenerator.
// Features:
//   • Horizontal rock strata with per-layer color variation
//   • Procedural cracks along layer boundaries (cellular noise)
//   • Weathering darkening at exposed edges
//   • Moss/lichen on sheltered overhangs (normal.y > 0.3)
//   • Roughness variation (smooth worn surfaces vs rough fractures)
//
// Compatible with gl_compatibility renderer (no tessellation/compute).
// All surface detail is generated analytically — no external texture files.
//
// Vertex color channels:
//   COLOR.rgb = per-strata rock color (set by CliffGenerator)
// ═══════════════════════════════════════════════════════════════════════════════

shader_type spatial;
render_mode cull_back, diffuse_burley, specular_schlick_ggx;

// ─── Varyings ─────────────────────────────────────────────────────────────────

varying vec3 v_world_pos;
varying vec3 v_world_normal;
varying vec3 v_vertex_color;
varying float v_elevation;

// ═══════════════════════════════════════════════════════════════════════════════
// NOISE FUNCTIONS (reused from terrain_pbr.gdshader)
// ═══════════════════════════════════════════════════════════════════════════════

// High-quality hash — avoids visible grid artifacts from simpler hashes.
float hash(vec2 p) {
    p = fract(p * vec2(443.897, 441.423));
    p += dot(p, p + 19.19);
    return fract(p.x * p.y);
}

// Smooth bicubic value noise with quintic interpolant (C2 continuous).
float valueNoise(vec2 p) {
    vec2 i = floor(p);
    vec2 f = fract(p);
    vec2 u = f * f * f * (f * (f * 6.0 - 15.0) + 10.0);
    float a = hash(i);
    float b = hash(i + vec2(1.0, 0.0));
    float c = hash(i + vec2(0.0, 1.0));
    float d = hash(i + vec2(1.0, 1.0));
    return mix(mix(a, b, u.x), mix(c, d, u.x), u.y);
}

// Multi-octave Fractal Brownian Motion — natural surface variation.
float fbm(vec2 p) {
    float v = 0.0;
    float a = 0.5;
    vec2 s = vec2(1.0);
    for (int i = 0; i < 5; i++) {
        v += a * valueNoise(p * s);
        s *= 2.13;
        a *= 0.5;
    }
    return v;
}

// 3-octave FBM for cheaper sampling.
float fbm3(vec2 p) {
    float v = 0.0;
    float a = 0.5;
    vec2 s = vec2(1.0);
    for (int i = 0; i < 3; i++) {
        v += a * valueNoise(p * s);
        s *= 2.13;
        a *= 0.5;
    }
    return v;
}

// Voronoi-style cellular noise for crack patterns.
float cellNoise(vec2 p) {
    vec2 i = floor(p);
    vec2 f = fract(p);
    float min_dist = 1.0;
    for (int y = -1; y <= 1; y++) {
        for (int x = -1; x <= 1; x++) {
            vec2 neighbor = vec2(float(x), float(y));
            vec2 point = vec2(hash(i + neighbor), hash(i + neighbor + vec2(31.0, 17.0)));
            vec2 diff = neighbor + point - f;
            float dist = length(diff);
            min_dist = min(min_dist, dist);
        }
    }
    return min_dist;
}

// ═══════════════════════════════════════════════════════════════════════════════
// VERTEX STAGE
// ═══════════════════════════════════════════════════════════════════════════════

void vertex() {
    v_world_pos = (MODEL_MATRIX * vec4(VERTEX, 1.0)).xyz;
    v_world_normal = normalize((MODEL_MATRIX * vec4(NORMAL, 0.0)).xyz);
    v_vertex_color = COLOR.rgb;
    v_elevation = VERTEX.y;
}

// ═══════════════════════════════════════════════════════════════════════════════
// FRAGMENT STAGE
// ═══════════════════════════════════════════════════════════════════════════════

void fragment() {
    vec3 pos = v_world_pos;
    vec3 normal = normalize(v_world_normal);

    // ── Strata coordinate: horizontal layers based on world Y ─────────────
    // Scale Y to create visible horizontal banding
    float strata_scale = 3.5;
    float strata_y = pos.y * strata_scale;

    // Layer index (integer part) and position within layer (fractional part)
    float layer_idx = floor(strata_y);
    float layer_frac = fract(strata_y);

    // ── Per-layer color variation ─────────────────────────────────────────
    // Use vertex color as base, modulate with noise for per-layer variation
    vec3 base_color = v_vertex_color;

    // Per-layer hue/value shift seeded by layer index
    float layer_hash = hash(vec2(layer_idx * 7.31, layer_idx * 13.17));
    float color_shift = (layer_hash - 0.5) * 0.15;

    // Warm/cool alternating bands
    vec3 warm_shift = vec3(1.06, 1.0, 0.92);
    vec3 cool_shift = vec3(0.94, 0.97, 1.06);
    vec3 band_tint = mix(cool_shift, warm_shift, layer_hash);

    vec3 strata_color = base_color * band_tint;
    strata_color += vec3(color_shift, color_shift * 0.7, color_shift * 0.4);

    // Add noise-based variation within each layer
    float layer_noise = fbm3(vec2(pos.x * 2.0 + layer_idx * 5.0, pos.z * 2.0));
    strata_color = mix(strata_color, strata_color * 0.85, (1.0 - layer_noise) * 0.3);

    // ── Procedural cracks along layer boundaries ──────────────────────────
    // Cracks appear at the transition between strata layers
    float boundary_dist = min(layer_frac, 1.0 - layer_frac);
    float boundary_mask = 1.0 - smoothstep(0.0, 0.12, boundary_dist);

    // Cellular noise for crack pattern along boundaries
    float crack_noise = cellNoise(vec2(pos.x * 4.0, pos.z * 4.0 + layer_idx * 3.7));
    float crack_mask = boundary_mask * (1.0 - smoothstep(0.05, 0.2, crack_noise));

    // Darken cracks
    strata_color *= mix(1.0, 0.4, crack_mask);

    // ── Weathering darkening at exposed edges ─────────────────────────────
    // Edges where the normal faces outward (exposed to weather) get darker
    // Use the absolute horizontal component of the normal as exposure indicator
    float exposure = length(vec2(normal.x, normal.z));
    float weathering = smoothstep(0.6, 1.0, exposure);

    // Additional weathering from noise for organic variation
    float weather_noise = fbm(pos.xz * 0.8);
    weathering *= mix(0.5, 1.0, weather_noise);

    // Apply weathering darkening
    strata_color *= mix(1.0, 0.7, weathering * 0.5);

    // ── Moss/lichen on sheltered overhangs ────────────────────────────────
    // Sheltered surfaces: normal.y > 0.3 (facing somewhat upward = overhang underside)
    float moss_mask = smoothstep(0.3, 0.6, normal.y);

    // Only grow moss in sheltered areas (not fully exposed tops)
    // Reduce moss on very steep upward faces (those are just flat ground)
    moss_mask *= (1.0 - smoothstep(0.8, 1.0, normal.y));

    // Noise-driven moss patches for organic distribution
    float moss_noise = fbm(pos.xz * 3.0 + vec2(pos.y * 0.5));
    moss_mask *= smoothstep(0.35, 0.6, moss_noise);

    // Moss color: dark green with slight variation
    vec3 moss_color = vec3(0.15, 0.3, 0.08) + vec3(0.05) * fbm3(pos.xz * 5.0);

    // Blend moss onto rock
    strata_color = mix(strata_color, moss_color, moss_mask * 0.8);

    // ── Roughness variation ───────────────────────────────────────────────
    // Smooth worn surfaces vs rough fractures
    float base_roughness = 0.82;

    // Cracks are rougher
    float roughness = mix(base_roughness, 0.98, crack_mask);

    // Worn smooth surfaces where water has polished the rock
    float worn_mask = smoothstep(0.4, 0.7, layer_noise) * (1.0 - crack_mask);
    roughness = mix(roughness, 0.55, worn_mask * 0.4);

    // Moss is moderately rough
    roughness = mix(roughness, 0.75, moss_mask * 0.6);

    // Micro-roughness variation from noise
    float micro_rough = (fbm3(pos.xz * 12.0) - 0.5) * 0.08;
    roughness = clamp(roughness + micro_rough, 0.0, 1.0);

    // ── Final output ──────────────────────────────────────────────────────
    ALBEDO = clamp(strata_color, 0.0, 1.0);
    ROUGHNESS = roughness;
    METALLIC = 0.0;
    SPECULAR = 0.04;

    // Procedural normal perturbation for micro-detail
    float eps = 0.4;
    float hL = fbm3(vec2(pos.x - eps, pos.y) * 3.0);
    float hR = fbm3(vec2(pos.x + eps, pos.y) * 3.0);
    float hD = fbm3(vec2(pos.z - eps, pos.y) * 3.0);
    float hU = fbm3(vec2(pos.z + eps, pos.y) * 3.0);
    vec3 perturbed_normal = normalize(vec3((hL - hR) * 0.8, 1.0, (hD - hU) * 0.8));
    NORMAL_MAP = perturbed_normal * 0.5 + 0.5;
    NORMAL_MAP_DEPTH = 0.7;
}
